<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="samples.mybatis.ProductMapper">
    <sql id="Base_Column_List">
        id, amount, status
    </sql>

    <select id="selectById" resultType="samples.lang.Order">
        SELECT <include refid="Base_Column_List"/> FROM orders WHERE id = #{id}
    </select>

    <insert id="insertOrder">
        INSERT INTO orders(id, amount, status) VALUES (#{id}, #{amount}, #{status})
    </insert>
</mapper>
