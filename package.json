{
  "name": "defhop",
  "displayName": "Defhop for Java",
  "description": "Java navigation helper powered by a Go engine. Instant go-to-definition and references - lightweight, fast, built for reading code.",
  "version": "1.0.7",
  "publisher": "vg0x00",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/iCodZilla/defhop.git"
  },
  "bugs": {
    "url": "https://github.com/iCodZilla/defhop/issues"
  },
  "homepage": "https://github.com/iCodZilla/defhop",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#1B1F24",
    "theme": "dark"
  },
  "keywords": [
    "java",
    "java helper",
    "java navigation",
    "go to definition",
    "find references",
    "code navigation",
    "mybatis",
    "spring",
    "feign",
    "lombok",
    "mapstruct",
    "maven",
    "gradle",
    "golang",
    "performance"
  ],
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onStartupFinished",
    "workspaceContains:pom.xml",
    "workspaceContains:build.gradle",
    "workspaceContains:build.gradle.kts",
    "workspaceContains:settings.gradle",
    "workspaceContains:settings.gradle.kts",
    "onLanguage:java",
    "onLanguage:xml",
    "onLanguage:yaml",
    "onLanguage:properties",
    "onCommand:defhop.refreshIndex",
    "onCommand:defhop.rebuildIndex",
    "onCommand:defhop.status",
    "onCommand:defhop.configureJdk",
    "onCommand:defhop.clearJdkHome",
    "onCommand:defhop.goDefinition",
    "onCommand:defhop.goMyBatisSql",
    "onCommand:defhop.goJavaDeclaration"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "defhop.refreshIndex",
        "title": "Defhop: Refresh Index (keep cache)"
      },
      {
        "command": "defhop.rebuildIndex",
        "title": "Defhop: Clear Cache and Rebuild"
      },
      {
        "command": "defhop.status",
        "title": "Defhop: Show Output"
      },
      {
        "command": "defhop.configureJdk",
        "title": "Defhop: Configure JDK Home"
      },
      {
        "command": "defhop.clearJdkHome",
        "title": "Defhop: Clear Project JDK Home"
      },
      {
        "command": "defhop.goDefinition",
        "title": "Defhop: Go to Definition (instant)"
      },
      {
        "command": "defhop.goMyBatisSql",
        "title": "Defhop: Go to MyBatis SQL"
      },
      {
        "command": "defhop.goJavaDeclaration",
        "title": "Defhop: Go to Java Declaration"
      }
    ],
    "keybindings": [
      {
        "command": "defhop.goDefinition",
        "key": "f12",
        "when": "editorTextFocus && !editorReadonly && resourceExtname =~ /\\.(java|xml|yml|yaml|properties)/i"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "defhop.goDefinition",
          "when": "editorLangId == java || editorLangId == xml || editorLangId == yaml || editorLangId == properties",
          "group": "navigation@1"
        },
        {
          "command": "defhop.goMyBatisSql",
          "when": "editorLangId == java",
          "group": "navigation@30"
        },
        {
          "command": "defhop.goJavaDeclaration",
          "when": "editorLangId == xml",
          "group": "navigation@30"
        }
      ]
    },
    "configuration": {
      "title": "Defhop",
      "properties": {
        "defhop.excludeDirectories": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            ".git",
            ".idea",
            "node_modules",
            "logs"
          ],
          "description": "Directories skipped during the initial source scan."
        },
        "defhop.jdkHome": {
          "type": "string",
          "default": "",
          "markdownDescription": "JDK home directory (or path to `src.zip`) for `java.*` navigation. Priority: **workspace** → **user** setting → `JAVA_HOME`/`JDK_HOME` → auto-detect. Env/auto results are written into the workspace setting so you usually do not need to set this by hand."
        }
      }
    }
  }
}
